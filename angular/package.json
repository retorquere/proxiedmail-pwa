{
  "name": "coreui-free-angular-admin-template",
  "version": "5.7.30",
  "copyright": "Copyright 2026 creativeLabs Łukasz Holeczek",
  "license": "MIT",
  "author": "The CoreUI Team (https://github.com/orgs/coreui/people) and contributors",
  "homepage": "https://coreui.io/angular",
  "config": {
    "theme": "default",
    "coreui_library_short_version": "5.7",
    "coreui_library_docs_url": "https://coreui.io/angular/docs/"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o --proxy-config proxy.conf.json",
    "build": "ng build",
    "postbuild": "npm run extract-i18n",
    "extract-i18n": "ng extract-i18n --format=xlf --output-path=src/locale",
    "format": "dprint fmt && prettier --write \"src/**/*.html\"",
    "format:check": "dprint check && prettier --check \"src/**/*.html\"",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/test-edge.mjs",
    "prebuild": "npm test -- --watch=false"
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/language-service": "^22.1.7",
    "@angular/localize": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@coreui/angular": "~5.7.30",
    "@coreui/coreui": "^5.9.0",
    "@coreui/icons": "^3.1.0",
    "@coreui/icons-angular": "~5.7.30",
    "@coreui/utils": "^2.0.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@types/node": "^26.6.2",
    "@vitest/browser-playwright": "^4.1.11",
    "dprint": "^0.49.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "npm": ">=10"
  },
  "bugs": {
    "url": "https://github.com/coreui/coreui-free-angular-admin-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreui/coreui-free-angular-admin-template.git"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
