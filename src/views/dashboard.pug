.shell
  header.topbar
    .topbar-inner
      .topbar-actions
        wa-badge(variant=twoFactorEnabled ? 'success' : 'warning')= twoFactorEnabled ? t('security.2faOn') : t('security.2faOff')
        wa-button#install-button(appearance='plain' size='s' hidden)!= icon('Download', 16) + ' ' + t('action.install')
        .user-menu
          wa-dropdown(placement='bottom-end')
            wa-button(slot='trigger' appearance='plain' size='s' aria-label=t('account.menu'))!= icon('User', 22)
            .user-popover
              wa-button#settings-button(appearance='plain' size='s')!= icon('Settings', 16) + ' ' + t('account.settings')
              wa-button#logout-button(appearance='plain' size='s')= t('action.signOut')
  main.content
    .page-heading
      div
        h1= t('dashboard.title')
        p.muted= t('dashboard.subtitle')
      wa-button#create-button(variant='brand' size='l')!= icon('Plus', 18) + ' ' + t('dashboard.newProxy')
    if notice
      wa-callout(variant='brand' open)= notice
    .summary-grid
      article.summary-card.primary
        .summary-label
          span= t('dashboard.addressesInUse')
          != icon('AtSign', 18)
        strong.summary-value= allBindings.length
          small= `/ ${bindingCapacity || '—'}`
        .quota-track
          span(style=`width:${bindingCapacity ? Math.min((allBindings.length / bindingCapacity) * 100, 100) : 0}%`)
      article.summary-card
        .summary-label
          span= t('dashboard.messagesForwarded')
          != icon('Inbox', 18)
        strong.summary-value= totalReceived
        p.summary-status= t('dashboard.inboxesActive', { count: allBindings.filter((binding) => binding.is_browsable).length })
      article.summary-card
        .summary-label
          span= t('dashboard.forwardingHealth')
          != icon('Activity', 18)
        strong.summary-value 100%
        p.summary-status= t('dashboard.allForwarding')
    section.entry-panel
      .entry-panel-head
        div
          h2= t('dashboard.proxyAddresses')
          p= t('dashboard.listHint')
        wa-input#search.search-box(size='s' value=searchValue placeholder=t('dashboard.search') with-clear)
      #binding-list.entry-list
        if bindings.length
          each binding, index in bindings
            article.entry-row(data-search-text=`${binding.proxy_address} ${binding.description || ''} ${Object.entries(binding.real_addresses || {}).map(([address]) => address).join(' ')}`.toLowerCase())
              button.entry-main(data-open-binding=binding.id aria-label=`Open ${binding.proxy_address}`)
                .entry-initials= binding.proxy_address.slice(0, 2).toUpperCase()
                .entry-copy
                  h3= binding.proxy_address
                  span.status= t('dashboard.active')
                  p= `${binding.description || t('dashboard.noDescription')} · ${Object.entries(binding.real_addresses || {}).filter(([, value]) => value.is_enabled).map(([address]) => address)[0] || t('dashboard.noRecipient')}`
              .entry-meta
                .entry-count
                  strong= binding.received_emails || 0
                  small= binding.is_browsable ? t('dashboard.stored') : t('dashboard.forwarded')
                wa-button(appearance='plain' size='s' data-open-binding=binding.id aria-label=t('status.open', { address: binding.proxy_address }))!= icon('ArrowUpRight', 19)
        else
          .empty-state= t('dashboard.empty')
    #modal-root