{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "proxiedmail-angular",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
